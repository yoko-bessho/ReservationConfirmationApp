{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "resources/ts/**/*",
        "resources/js/**/*"]
}
